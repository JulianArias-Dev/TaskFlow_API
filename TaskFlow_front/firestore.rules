rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isSystemAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User profile validation
    function isValidUserCreate(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'PROJECT_MANAGER', 'DEVELOPER'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.uid is string &&
             (!('email' in data) || data.email is string) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('role' in data) || data.role in ['ADMIN', 'PROJECT_MANAGER', 'DEVELOPER']) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('description' in data) || data.description is string) &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('theme' in data) || data.theme in ['light', 'dark']) &&
             (!('notificationPreferences' in data) || data.notificationPreferences is map) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSavedFilterCreate(data, uId) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'userId', 'criteria', 'createdAt']) &&
             data.userId == uId &&
             data.userId == request.auth.uid &&
             data.projectId is string &&
             data.name is string && data.name.size() > 0 &&
             data.criteria is map &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // allow members lookup
      allow create: if isOwner(userId) && isValidUserCreate(incoming());
      allow update: if isSignedIn() && 
                      isValidUserUpdate(incoming()) && 
                      (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                      (
                        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt', 'photoURL', 'description', 'lastLoginAt', 'notificationPreferences', 'theme'])) ||
                        (isSystemAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'isActive', 'updatedAt']))
                      );
                      
      match /projects/{projectId} {
        allow read: if isOwner(userId) || isSystemAdmin();
        allow write: if isSystemAdmin() || 
                     isOwner(userId) ||
                     get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
      
      match /saved_filters/{filterId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedFilterCreate(incoming(), userId);
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'criteria']) && incoming().name is string && incoming().criteria is map;
        allow delete: if isOwner(userId);
      }
    }

    match /user_emails/{emailId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
    }

    match /globalSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    function isValidProjectCreate(data, projectId) {
      return data.keys().hasAll(['id', 'name', 'key', 'description', 'ownerId', 'leadId', 'status', 'createdAt', 'updatedAt']) &&
             data.id == projectId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 10 &&
             data.description is string &&
             data.ownerId == request.auth.uid &&
             data.leadId is string &&
             data.status in ['PLANIFICADO', 'EN_PROGRESO', 'PAUSADO', 'COMPLETADO', 'ARCHIVADO'] &&
             (!('startDate' in data) || data.startDate is string || data.startDate is timestamp) &&
             (!('endDate' in data) || data.endDate is string || data.endDate is timestamp) &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    // Projects: Only owner can manage
    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && (
                   resource.data.ownerId == request.auth.uid ||
                   isSystemAdmin() ||
                   exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
                 );
      allow create: if isSignedIn() && isValidProjectCreate(incoming(), projectId);
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSystemAdmin()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'key', 'description', 'startDate', 'endDate', 'status', 'updatedAt']);
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSystemAdmin());

      // Boards subcollection
      match /boards/{boardId} {
        allow read: if isSignedIn() && (
                            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                            exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                            isSystemAdmin()
                          );
        allow write: if isSignedIn() && (
                            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                            exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                            isSystemAdmin()
                          ) && get(/databases/$(database)/documents/projects/$(projectId)).data.get('status', '') != 'ARCHIVADO';
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read: if isSignedIn() && (
                      get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                      exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                      isSystemAdmin()
                    );
        allow create: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                        isSystemAdmin()
                      ) &&
                      incoming().reporterId == request.auth.uid &&
                       get(/databases/$(database)/documents/projects/$(projectId)).data.get('status', '') != 'ARCHIVADO' &&
                      incoming().createdAt == request.time;
        allow update: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                        isSystemAdmin()
                      ) && get(/databases/$(database)/documents/projects/$(projectId)).data.get('status', '') != 'ARCHIVADO';
        allow delete: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                        isSystemAdmin()
                      ) && get(/databases/$(database)/documents/projects/$(projectId)).data.get('status', '') != 'ARCHIVADO';
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn() && (
                      get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                      exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                      isSystemAdmin()
                    );
        allow create: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        isSystemAdmin()
                      ) &&
                      incoming().uid == memberId &&
                      incoming().keys().hasAll(['uid', 'email', 'role', 'joinedAt']);
        allow delete: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        isSystemAdmin() ||
                        memberId == request.auth.uid
                      );
        allow update: if isSignedIn() && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        isSystemAdmin()
                      ) && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
      }

      function isValidProjectAuditLogCreate(data) {
        return data.keys().hasAll(['id', 'projectId', 'action', 'entityType', 'entityId', 'userId', 'createdAt']) &&
               data.projectId == projectId &&
               data.action in ['CREATE', 'UPDATE', 'DELETE'] &&
               data.entityType in ['BOARD', 'TASK', 'PROJECT'] &&
               data.entityId is string &&
               data.userId == request.auth.uid &&
               (!('details' in data) || data.details is string) &&
               data.createdAt == request.time;
      }

      // Presence subcollection
      match /presence/{memberId} {
        allow read: if isSignedIn() && (
                      get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                      exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                      isSystemAdmin()
                    );
        allow write: if isSignedIn() && memberId == request.auth.uid && (
                        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                        isSystemAdmin()
                      );
      }
      
      // Audit Logs subcollection
      match /audit_logs/{logId} {
        allow read: if isSignedIn() && (
                      get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                      exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                      isSystemAdmin()
                    );
        allow create: if isSignedIn() && (
                      get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
                      exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
                      isSystemAdmin()
                    ) && isValidProjectAuditLogCreate(incoming());
        allow update, delete: if false; // Audit logs must be immutable
      }
    }

    // Collection needed for the initial connection test
    match /test/connection {
      allow get: if true;
    }

    function isValidNotificationCreate(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'taskId', 'projectId', 'title', 'message', 'read', 'createdAt']) &&
             data.id is string &&
             data.userId is string &&
             data.type in ['ASSIGNED', 'DUE_OVERDUE', 'COMMENT', 'STATUS_CHANGE'] &&
             data.taskId is string &&
             data.projectId is string &&
             data.title is string &&
             data.message is string &&
             data.read is bool && data.read == false &&
             data.createdAt == request.time;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotificationCreate(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
