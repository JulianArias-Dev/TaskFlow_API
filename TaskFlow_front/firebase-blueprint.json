{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "description": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "PROJECT_MANAGER", "DEVELOPER"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "ASSIGNED": {
              "type": "object",
              "properties": {
                "inApp": { "type": "boolean" },
                "email": { "type": "boolean" }
              }
            },
            "DUE_OVERDUE": {
              "type": "object",
              "properties": {
                "inApp": { "type": "boolean" },
                "email": { "type": "boolean" }
              }
            },
            "COMMENT": {
              "type": "object",
              "properties": {
                "inApp": { "type": "boolean" },
                "email": { "type": "boolean" }
              }
            },
            "STATUS_CHANGE": {
              "type": "object",
              "properties": {
                "inApp": { "type": "boolean" },
                "email": { "type": "boolean" }
              }
            }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "ProjectMember": {
      "title": "Project Member",
      "description": "A user who is a member of a project",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "PROJECT_MANAGER", "DEVELOPER"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "UserProject": {
      "title": "User Project",
      "description": "Reference to a project a user is a member of",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId"]
    },
    "UserEmail": {
      "title": "User Email",
      "description": "Look up uid by email",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "A project containing boards and tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["PLANIFICADO", "EN_PROGRESO", "PAUSADO", "COMPLETADO", "ARCHIVADO"] },
        "leadId": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "key", "ownerId", "status"]
    },
    "Board": {
      "title": "Board",
      "description": "A board for visualizing tasks within a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["kanban", "scrum"] },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "wipLimit": { "type": "number" }
            },
            "required": ["id", "name"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "name", "type"]
    },
    "Task": {
      "title": "Task",
      "description": "A work item or issue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "boardId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string", "enum": ["BAJA", "MEDIA", "ALTA", "URGENTE"] },
        "type": { "type": "string", "enum": ["BUG", "FEATURE", "TASK", "IMPROVEMENT"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "estimatedHours": { "type": "number" },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["color", "name"]
          }
        },
        "reporterId": { "type": "string" },
        "assigneeId": { "type": "string" },
        "assigneeIds": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "completed": { "type": "boolean" }
            },
            "required": ["id", "title", "completed"]
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "userId": { "type": "string" },
              "content": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "userId", "content", "createdAt"]
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "url": { "type": "string" },
              "size": { "type": "number" },
              "type": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "name", "url", "size", "type", "createdAt"]
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "userId": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "type", "userId", "timestamp"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "title", "status", "priority", "type", "reporterId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["ASSIGNED", "DUE_OVERDUE", "COMMENT", "STATUS_CHANGE"] },
        "taskId": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "taskId", "projectId", "title", "message", "read", "createdAt"]
    },
    "ProjectAuditLog": {
      "title": "Project Audit Log",
      "description": "Log of actions performed in a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
        "entityType": { "type": "string", "enum": ["BOARD", "TASK", "PROJECT"] },
        "entityId": { "type": "string" },
        "userId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "action", "entityType", "entityId", "userId", "createdAt"]
    },
    "SavedFilter": {
      "title": "Saved Filter",
      "description": "Saved task filter configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "criteria": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "name", "userId", "criteria", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "users/{userId}/projects": {
      "schema": "UserProject",
      "description": "Projects the user is a member of"
    },
    "user_emails": {
      "schema": "UserEmail",
      "description": "Lookup table for user emails"
    },
    "projects": {
      "schema": "Project",
      "description": "Main collection for projects"
    },
    "projects/{projectId}/boards": {
      "schema": "Board",
      "description": "Subcollection of boards per project"
    },
    "projects/{projectId}/tasks": {
      "schema": "Task",
      "description": "Subcollection of tasks per project"
    },
    "projects/{projectId}/members": {
      "schema": "ProjectMember",
      "description": "Subcollection of members per project"
    },
    "notifications": {
      "schema": "Notification",
      "description": "Collection of user notifications"
    },
    "projects/{projectId}/audit_logs": {
      "schema": "ProjectAuditLog",
      "description": "Subcollection of audit logs per project"
    },
    "users/{userId}/saved_filters": {
      "schema": "SavedFilter",
      "description": "Subcollection of saved task filters"
    }
  }
}
