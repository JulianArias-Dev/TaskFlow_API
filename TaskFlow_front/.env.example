# ----------------------------------------------------------------------------
# TaskFlow Frontend - variables de entorno
# ----------------------------------------------------------------------------

# URL base de la TaskFlow API (.NET). Si la dejas vacía, en dev se proxea vía
# Vite (/api → VITE_BACKEND_PROXY_URL); en prod nginx hace el proxy a /api/.
# Ejemplo para acceso directo: VITE_API_URL="http://localhost:8080/api"
VITE_API_URL=""

# Backend al que apunta el proxy de Vite en desarrollo (no se usa en prod).
VITE_BACKEND_PROXY_URL="http://localhost:8080"

# Opcional: clave de Gemini si se integra IA en el cliente.
GEMINI_API_KEY=""
